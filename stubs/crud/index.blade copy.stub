<x-app-layout>
    <div class="container-fluid px-4 py-4" x-data="{{ alpineComponent }}">
        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">{{ title }} Management</h4>
                <p class="text-muted small mb-0">Manage {{ title }} data and information.</p>
            </div>

            <div class="text-md-end d-flex align-items-center gap-2">
                {{-- Hapus komentar di bawah ini jika ingin menggunakan tombol export --}}
                {{-- <x-export-button event="export-{{ viewFolder }}" /> --}}
                
                <x-create-button event="open-{{ viewFolder }}-modal" class="btn btn-primary shadow-sm" />
            </div>
        </div>

        <!-- Filter & Search Bar Section -->
        <div class="bg-white border rounded-3 p-3 mb-3 shadow-sm">
            <form class="row g-3 align-items-center justify-content-between" @submit.prevent>
                <div class="col-12 d-flex flex-column flex-md-row align-items-md-center gap-2">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 w-100" style="max-width: 400px;">
                        <label for="search" class="form-label mb-0 text-nowrap">Search</label>
                        <input type="search" id="search" class="form-control w-100" placeholder="Search..." x-model="search">
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <x-search-button event="{{ viewFolder }}-table-reload" />
                    </div>
                </div>
            </form>
        </div>

        <!-- Pemanggilan Component Table -->
        <x-datatable-card
            tableId="{{ viewFolder }}-table" ajaxUrl="{{ route('{{ viewFolder }}.index') }}">
            <x-slot:header>
                <th class="py-3 ps-3 text-secondary text-center" width="5%">No</th>
                
                {{ tableHeaders }}

                <th class="py-3 pe-3 text-end text-secondary" width="20%">Actions</th>
            </x-slot:header>
        </x-datatable-card>

        @include('{{ viewFolder }}.partials.form')
    </div>

    @push('scripts')
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('{{ alpineComponent }}', () => ({
                search: '',
                inactiveOnly: false,

                init() {
                    window.edit{{ model }} = id => this.editItem(id);
                    window.delete{{ model }} = id => this.deleteItem(id);
                },

                getTableColumns() {
                    return [{
                            data: null,
                            name: 'no',
                            orderable: false,
                            searchable: false,
                            className: 'ps-3 text-dark fw-semibold text-nowrap text-center',
                            render: (data, type, row, meta) => meta.row + this.displayStart + 1
                        },
                        
                        {{ tableColumns }}, 

                        {
                            data: 'id',
                            name: 'action',
                            orderable: false,
                            searchable: false,
                            className: 'text-end pe-3 text-nowrap',
                            render: data => `
                                <div class="d-flex justify-content-end gap-1">
                                    <x-edit-button onclick="window.edit{{ model }}(${data})" />
                                    <x-delete-button onclick="window.delete{{ model }}(${data})" />
                                </div>
                            `
                        }
                    ];
                },

                editItem(id) {
                    axios.get(`{{ viewFolder }}/${id}/edit`)
                        .then(res => {
                            window.dispatchEvent(new CustomEvent('open-{{ viewFolder }}-modal', {
                                detail: res.data.data
                            }));
                        })
                        .catch(() => alert('Failed to fetch data.'));
                },

                deleteItem(id) {
                    if (!confirm('Are you sure you want to delete this record?')) return;

                    axios.delete(`{{ viewFolder }}/${id}`, {
                            headers: {
                                'X-CSRF-TOKEN': '{{ csrf_token() }}'
                            }
                        })
                        .then(() => {
                            window.dispatchEvent(new CustomEvent('{{ viewFolder }}-table-reload'));
                            alert('Data successfully deleted!');
                        })
                        .catch(() => alert('Failed to delete data.'));
                }
            }));
        });
    </script>
    @endpush
</x-app-layout>